# Environment of caddy.service: /etc/sparkpass/caddy.env (owner root, group caddy, mode 0640).
# install.sh copies this file there only when that file does not exist. systemd reads it
# (EnvironmentFile= in /etc/systemd/system/caddy.service.d/sparkpass.conf): one KEY=VALUE on each
# line, no spaces around "=", and comments only on their own lines. Fill both values before the
# first start of Caddy.
# Put no secret in this file: `caddy run --environ` writes the whole environment to the journal at
# each start.

# Site address of the public listener: the ts.net name of this unit on Tailscale Funnel, the host of
# PUBLIC_URL in /etc/sparkpass/config with no https://, for example spark.tail1234.ts.net. No trailing
# dot: the DNSName of `tailscale status --json` ends with ".", so remove it. Caddy gets its certificate
# from tailscaled (TS_PERMIT_CERT_UID=caddy in /etc/default/tailscaled).
SPARKPASS_SITE=

# API port of the model server on 127.0.0.1: the same value as MODEL_PORT in /etc/sparkpass/config.
# No quotes around a value: install.sh compares SPARKPASS_MODEL_PORT with MODEL_PORT of /etc/sparkpass/config.
SPARKPASS_MODEL_PORT=

# SPARKPASS_BIND and SPARKPASS_MODEL_HOST: leave them unset on the unit (no line at all), so the
# Caddyfile uses 127.0.0.1 for both: Caddy listens only where tailscaled forwards the TCP of Funnel.
# Only tests/gateway.sh sets them. An empty SPARKPASS_BIND makes Caddy 2.6.2 listen on all addresses.
