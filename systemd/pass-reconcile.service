# sparkpass boot gate and retry (docs/designs/guest-pass-mvp.md, "Locking, start order, and the boot gate").
# It runs at boot (multi-user.target) and from pass-reconcile.timer. Only this unit starts caddy.service.
# install.sh copies it to /etc/systemd/system/.
[Unit]
Description=sparkpass reconcile: firewall rules, overdue revokes, end timers, gateway start and check
# Docker first, for the DOCKER-USER chain of the firewall rules. time-sync.target waits for a real clock
# only when its wait service is enabled (install.sh enables systemd-time-wait-sync or chrony-wait):
# with no network at boot, this unit waits and the gateway stays closed. systemd-time-wait-sync waits
# with no limit. The chrony-wait unit of the Ubuntu package stops waiting after 180 s, so install.sh
# adds a drop-in with TimeoutStartSec=infinity to it.
# After tailscaled too: Caddy gets the certificate of the ts.net name from it, and the gateway check runs
# right after the start of Caddy. After= orders the start only; tailscaled needs its first netmap before
# it gives the certificate and reads its serve config (ExecStartPre below). Not in Wants=: that would start
# tailscaled at each run (every 5 minutes) and undo an owner's stop of the public route (owner decision D8 of
# the /ship review, 2026-10-07). For the same reason, not tailscale-online.target: its wait service has
# Requires=tailscaled.service and no time limit.
After=network-online.target docker.service time-sync.target tailscaled.service
Wants=network-online.target time-sync.target

[Service]
# Oneshot with no RemainAfterExit: the unit is inactive after each run, so the timer can start it again.
Type=oneshot
# At boot the clock can sync some seconds before tailscaled gets its first netmap (spark-3, the power cut of
# 2026-10-21: 4 s). Then the gateway check failed (curl exit code 35, no certificate), the gateway stayed stopped
# until the next run, and the serve config read `{}`. So wait until tailscaled runs, at most 10 s; it returns at
# once when tailscaled runs. "-": a failed wait (tailscaled stopped by the owner, or a tailscale with no `wait`)
# counts for nothing, because the firewall rules and the revokes of the run must not wait for tailscaled. It runs
# before the lock, so the end timer does not wait for it.
ExecStartPre=-/usr/bin/tailscale wait --timeout=10s
ExecStart=/usr/local/bin/sparkpass reconcile
# Budget: the wait above (10 s), and each system command has a limit of 10 s: one run with a lease runs at most
# 18 commands: 14 under the lock with a margin (one long path: firewall, end-timer check, create and check, the
# revoke of a lease that became overdue, start, two wrong-key checks, stop and the marker notification, 12), and
# after it the gateway-down notification, the read of the serve config of tailscaled, the read of its state and
# the notification = 190 s, plus the wait for the lock. systemd stops a run that hangs, the lock opens, and the
# next run 5 minutes later repeats the work. RUN_LIMIT in src/reconcile.rs is the same number.
TimeoutStartSec=195

[Install]
WantedBy=multi-user.target
